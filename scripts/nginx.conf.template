worker_processes auto;
pid /tmp/bidhelm-nginx.pid;
error_log /dev/stderr warn;
worker_shutdown_timeout 10s;
events { worker_connections 4096; }
http {
    client_body_temp_path /tmp/bidhelm-nginx/body;
    proxy_temp_path /tmp/bidhelm-nginx/proxy;
    fastcgi_temp_path /tmp/bidhelm-nginx/fastcgi;
    uwsgi_temp_path /tmp/bidhelm-nginx/uwsgi;
    scgi_temp_path /tmp/bidhelm-nginx/scgi;
    client_max_body_size 16m;
    client_header_timeout 5s;
    client_body_timeout 10s;
    send_timeout 15s;
    keepalive_timeout 60s;
    # Literal key: shared by every source, client, Host and worker.
    limit_req_zone "all_sources" zone=dsp_total:1m rate=__DSP_RPS__r/s;
    log_format traffic 'status=$status limit=$limit_req_status upstream=$upstream_status duration=$request_time';
    map $limit_req_status $log_traffic { "" 0; default 1; }
    access_log /dev/stdout traffic if=$log_traffic;
    upstream dsp { server 127.0.0.1:8083; keepalive 64; }
    server {
        listen 8080 default_server;
        server_name _;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        proxy_connect_timeout 2s;
        proxy_read_timeout 15s;
        proxy_send_timeout 10s;
        proxy_intercept_errors off;
        location /source/ {
            limit_req zone=dsp_total burst=__DSP_BURST__ nodelay;
            limit_req_log_level notice;
            limit_req_status 429;
            error_page 429 = @no_bid;
            proxy_pass http://dsp;
        }
        location @no_bid { return 204; }
        location / { proxy_pass http://dsp; }
    }
}
